# Copy to .env.local; never commit actual values.
# Server-only Supabase project URL + publishable key (legacy anon key also supported).
# No NEXT_PUBLIC_* credentials; no service_role/secret key is used by this application.
# Official Quickstart NEXT_PUBLIC_* values map to these server-only names.
# See docs/SUPABASE_SETUP.md; restart Next.js after editing .env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact browser-facing origin for CSRF checks and email confirmation redirects.
# Production: HTTPS origin, e.g. https://your-deployment.example
APP_URL=http://localhost:3000

# Server-only OpenAI; never commit a real key. No paid calls during build.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Groq: preferred over OpenAI when GROQ_API_KEY is set.
# Keep the key server-side; never commit it or prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
