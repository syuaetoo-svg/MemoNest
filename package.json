{
  "name": "memonest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:ux": "playwright test",
    "test:core": "node --import tsx --test tests/core/*.test.ts tests/core/*.test.tsx",
    "test:core:browser": "playwright test --config playwright.core.config.ts",
    "test:core:live": "CORE_E2E=1 playwright test --config playwright.core.config.ts",
    "test:server": "node --conditions=react-server --import tsx --test tests/server/*.test.ts tests/ai/*.test.ts",
    "supabase:check": "node --use-env-proxy --conditions=react-server --import tsx scripts/check-supabase.ts",
    "test:ai:live": "node --use-env-proxy --conditions=react-server --import tsx scripts/check-groq.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
